# Copy this file to .env and fill in real values if/when you plug in a
# real LLM provider. Never commit your actual .env file.
#
# The default configuration (llm.provider: mock in config/collaboration.yaml)
# does not require any of these -- the system runs fully offline out of the box.

# Environment variable name read by RealLLMProvider (see core/llm_provider.py).
# Set the actual key in your local, uncommitted .env file, e.g.:
# LLM_API_KEY=sk-...
LLM_API_KEY=

# Optional: override the logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
